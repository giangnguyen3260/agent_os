{
  "name": "agentos-frontend",
  "version": "0.1.0",
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "build": "ng build",
    "test": "ng test",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css,html}\"",
    "test:tooling": "node scripts/test-editor-dependency.cjs && node scripts/test-tooling-security.cjs",
    "test:e2e": "playwright test",
    "audit:check": "npm audit --include=dev --audit-level=low"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource/inter": "5.2.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "1.64.1",
    "eslint": "9.39.2",
    "gts": "7.0.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "overrides": {
    "external-editor": {
      "tmp": "0.2.7"
    },
    "@angular/cli": {
      "@modelcontextprotocol/sdk": "1.32.0"
    },
    "@angular/build": {
      "vite": "7.3.7"
    }
  }
}
