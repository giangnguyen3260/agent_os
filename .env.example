# Copy to .env and replace this value before running Compose. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_USER=agentos
POSTGRES_DB=agentos
APP_PORT=8080
# Opt-in once to provision the first human admin. No default account is created.
# Enable, fill all values, start the stack, then disable and remove the password.
AGENTOS_BOOTSTRAP_ENABLED=false
AGENTOS_BOOTSTRAP_EMAIL=
AGENTOS_BOOTSTRAP_DISPLAY_NAME=
AGENTOS_BOOTSTRAP_PASSWORD=
# Localhost HTTP only. Set true behind HTTPS.
AGENTOS_SESSION_COOKIE_SECURE=false
# Docker recovery emails are delivered to the local Mailpit inbox.
AGENTOS_RECOVERY_ENABLED=true
AGENTOS_RECOVERY_FRONTEND_BASE_URL=http://localhost:8080
AGENTOS_RECOVERY_FROM=no-reply@agentos.local
MAILPIT_PORT=8025

# Invitation emails stay in the local Mailpit inbox; no external delivery.
AGENTOS_INVITATIONS_ENABLED=true
AGENTOS_INVITATIONS_FRONTEND_BASE_URL=http://localhost:8080
AGENTOS_INVITATIONS_FROM=no-reply@agentos.local
